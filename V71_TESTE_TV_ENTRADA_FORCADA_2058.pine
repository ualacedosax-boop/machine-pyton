//@version=6
strategy("V71 TESTE TV Entrada Forcada 2058",
     overlay=true,
     pyramiding=0,
     default_qty_type=strategy.fixed,
     default_qty_value=1)

// Diagnostico separado. Nao e candidato operacional e NAO altera o V7.1 oficial.
// Objetivo: confirmar se o TradingView esta executando entradas no MNQ1! 2m.

takePontos = input.float(50.5, "Take em pontos", step=0.25)
stopPontos = input.float(117.0, "Stop em pontos", step=0.25)
horaAlvo = input.int(20, "Hora alvo SP", minval=0, maxval=23)
minutoAlvo = input.int(58, "Minuto alvo SP", minval=0, maxval=59)
mostrarPainel = input.bool(true, "Mostrar painel")

takeTicks = int(math.round(takePontos / syminfo.mintick))
stopTicks = int(math.round(stopPontos / syminfo.mintick))

hSP = hour(time, "America/Sao_Paulo")
mSP = minute(time, "America/Sao_Paulo")
minSP = hSP * 60 + mSP
alvoSP = horaAlvo * 60 + minutoAlvo
dayKey = year(time, "America/Sao_Paulo") * 10000 + month(time, "America/Sao_Paulo") * 100 + dayofmonth(time, "America/Sao_Paulo")

var int dayKeyPrev = na
var bool entrouHoje = false
if na(dayKeyPrev) or dayKey != dayKeyPrev
    dayKeyPrev := dayKey
    entrouHoje := false

ema17 = ta.ema(close, 17)
ema34 = ta.ema(close, 34)
plot(ema17, "EMA 17", color=color.purple, linewidth=2)
plot(ema34, "EMA 34", color=color.blue, linewidth=2)

direcaoBuy = ema17 >= ema34
horarioLiberado = minSP >= alvoSP
entradaForcada = strategy.position_size == 0 and not entrouHoje and horarioLiberado

if entradaForcada and direcaoBuy
    entrouHoje := true
    strategy.entry("TESTE_BUY", strategy.long, alert_message="V71 TESTE TV BUY")
else if entradaForcada
    entrouHoje := true
    strategy.entry("TESTE_SELL", strategy.short, alert_message="V71 TESTE TV SELL")

strategy.exit("X_TESTE_BUY", from_entry="TESTE_BUY", profit=takeTicks, loss=stopTicks)
strategy.exit("X_TESTE_SELL", from_entry="TESTE_SELL", profit=takeTicks, loss=stopTicks)

plotshape(entradaForcada and direcaoBuy, title="TESTE BUY", style=shape.triangleup, location=location.belowbar,
     color=color.lime, size=size.small, text="TB")
plotshape(entradaForcada and not direcaoBuy, title="TESTE SELL", style=shape.triangledown, location=location.abovebar,
     color=color.red, size=size.small, text="TS")

var table painel = table.new(position.top_right, 2, 6, bgcolor=color.new(color.black, 20))
if mostrarPainel and barstate.islast
    table.cell(painel, 0, 0, "V71 TESTE", text_color=color.white)
    table.cell(painel, 1, 0, "FORCADO", text_color=color.yellow)
    table.cell(painel, 0, 1, "Hora SP", text_color=color.white)
    table.cell(painel, 1, 1, str.tostring(hSP) + ":" + (mSP < 10 ? "0" : "") + str.tostring(mSP), text_color=color.white)
    table.cell(painel, 0, 2, "Alvo", text_color=color.white)
    table.cell(painel, 1, 2, str.tostring(horaAlvo) + ":" + (minutoAlvo < 10 ? "0" : "") + str.tostring(minutoAlvo), text_color=color.white)
    table.cell(painel, 0, 3, "Liberado", text_color=color.white)
    table.cell(painel, 1, 3, horarioLiberado ? "SIM" : "NAO", text_color=horarioLiberado ? color.lime : color.gray)
    table.cell(painel, 0, 4, "Entrou hoje", text_color=color.white)
    table.cell(painel, 1, 4, entrouHoje ? "SIM" : "NAO", text_color=entrouHoje ? color.lime : color.gray)
    table.cell(painel, 0, 5, "Oficial", text_color=color.white)
    table.cell(painel, 1, 5, "NAO ALTERADO", text_color=color.orange)
