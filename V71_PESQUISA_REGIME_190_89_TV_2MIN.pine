//@version=6
strategy("V71 Pesquisa Regime 190 89 TV 2m",
     overlay=true,
     pyramiding=0,
     default_qty_type=strategy.fixed,
     default_qty_value=1)

// Pesquisa separada. NAO altera o V7.1 oficial.
// Candidato local: 190 trades 365d, 88.95%, +6077.5 pontos, DD -417.5, PF 3.47.
// Validar no MNQ1! 2 minutos com Backtesting Profundo.

takePontos = input.float(50.5, "Take em pontos", step=0.25)
stopPontos = input.float(117.0, "Stop em pontos", step=0.25)
mostrarPainel = input.bool(true, "Mostrar painel")

takeTicks = int(math.round(takePontos / syminfo.mintick))
stopTicks = int(math.round(stopPontos / syminfo.mintick))

hSP = hour(time, "America/Sao_Paulo")
mSP = minute(time, "America/Sao_Paulo")
dowSP = dayofweek(time, "America/Sao_Paulo")

eh0348 = hSP == 3 and mSP == 48
eh1030 = hSP == 10 and mSP == 30
eh2052 = hSP == 20 and mSP == 52
eh2058 = hSP == 20 and mSP == 58

seg = dowSP == dayofweek.monday
ter = dowSP == dayofweek.tuesday
qua = dowSP == dayofweek.wednesday
sex = dowSP == dayofweek.friday
dom = dowSP == dayofweek.sunday

ema17 = ta.ema(close, 17)
ema34 = ta.ema(close, 34)
ema200 = ta.ema(close, 200)
sma17 = ta.sma(close, 17)
sma34 = ta.sma(close, 34)
ema12 = ta.ema(close, 12)
ema26 = ta.ema(close, 26)
macd = ema12 - ema26
macdSignal = ta.ema(macd, 9)
roc5 = close - close[5]
roc10 = close - close[10]
prevRoc5 = roc5[1]
body = close - open
vwapDia = ta.vwap(hlc3)
[diPlus, diMinus, adx14] = ta.dmi(14, 14)
dmiGap = math.abs(diPlus - diMinus)
ema34Slope10 = ema34 - ema34[10]
ema200Slope10 = ema200 - ema200[10]
range30 = ta.highest(high, 15) - ta.lowest(low, 15)
ret60 = close - close[30]

plot(ema17, "EMA 17", color=color.purple, linewidth=2)
plot(ema34, "EMA 34", color=color.blue, linewidth=2)

votoMacd = macd >= macdSignal ? 1 : -1
votoCandle = body >= 0 ? 1 : -1
votoPrevRoc5Contra = prevRoc5 <= 0 ? 1 : -1
votoSma1734 = sma17 >= sma34 ? 1 : -1
votoRoc10 = roc10 >= 0 ? 1 : -1
votoEma1734 = ema17 >= ema34 ? 1 : -1
votoRoc5 = roc5 >= 0 ? 1 : -1
votoVwap = close >= vwapDia ? 1 : -1

score0348 = votoMacd + votoCandle + votoPrevRoc5Contra
score1030 = votoSma1734 + votoRoc10 + votoPrevRoc5Contra
score2058 = votoEma1734 + votoRoc5 + votoVwap

baseDmiOk = dmiGap >= 3
baseB0348 = eh0348 and baseDmiOk and score0348 >= 0 and (seg or ter)
baseB1030 = eh1030 and baseDmiOk and score1030 >= 0 and seg
baseS1030 = eh1030 and baseDmiOk and score1030 < 0 and sex
baseB2058 = eh2058 and baseDmiOk and score2058 >= 0 and (dom or qua)

baseBuy = baseB0348 or baseB1030 or baseB2058
baseSell = baseS1030

regimeS0348 = eh0348 and ema17 < ema34 and diMinus > diPlus and adx14 >= 20 and ema34Slope10 >= -4.01
regimeB1030 = eh1030 and ema17 >= ema34 and diPlus >= diMinus and adx14 >= 30 and ema200Slope10 >= 5.67
regimeS1030 = eh1030 and ema17 < ema34 and diMinus > diPlus and adx14 >= 25 and dmiGap >= 3 and ema200Slope10 >= -10.26
regimeB2052 = eh2052 and ema17 >= ema34 and diPlus >= diMinus and adx14 >= 25 and range30 <= 18.44
regimeS2052 = eh2052 and ema17 < ema34 and diMinus > diPlus and adx14 >= 20 and dmiGap >= 10 and ret60 >= -27.75
regimeS2058 = eh2058 and ema17 < ema34 and diMinus > diPlus and adx14 >= 20 and adx14 <= 25.1 and dmiGap >= 10

entradaLiberada = strategy.position_size == 0
baseAtual = baseB0348 or baseB1030 or baseS1030 or baseB2058
entraBaseB0348 = entradaLiberada and baseB0348
entraBaseB1030 = entradaLiberada and baseB1030
entraBaseS1030 = entradaLiberada and baseS1030
entraBaseB2058 = entradaLiberada and baseB2058
entraRegimeS0348 = entradaLiberada and not baseAtual and regimeS0348
entraRegimeB1030 = entradaLiberada and not baseAtual and regimeB1030
entraRegimeS1030 = entradaLiberada and not baseAtual and regimeS1030
entraRegimeB2052 = entradaLiberada and not baseAtual and regimeB2052
entraRegimeS2052 = entradaLiberada and not baseAtual and regimeS2052
entraRegimeS2058 = entradaLiberada and not baseAtual and regimeS2058

if entraBaseB0348
    strategy.entry("B0348", strategy.long, alert_message="V71 PESQUISA REGIME BUY 03:48")
else if entraBaseB1030
    strategy.entry("B1030", strategy.long, alert_message="V71 PESQUISA REGIME BUY 10:30")
else if entraBaseS1030
    strategy.entry("S1030", strategy.short, alert_message="V71 PESQUISA REGIME SELL 10:30")
else if entraBaseB2058
    strategy.entry("B2058", strategy.long, alert_message="V71 PESQUISA REGIME BUY 20:58")
else if entraRegimeS0348
    strategy.entry("S0348", strategy.short, alert_message="V71 PESQUISA REGIME SELL 03:48")
else if entraRegimeB1030
    strategy.entry("B1030", strategy.long, alert_message="V71 PESQUISA REGIME BUY 10:30")
else if entraRegimeS1030
    strategy.entry("S1030", strategy.short, alert_message="V71 PESQUISA REGIME SELL 10:30")
else if entraRegimeB2052
    strategy.entry("B2052", strategy.long, alert_message="V71 PESQUISA REGIME BUY 20:52")
else if entraRegimeS2052
    strategy.entry("S2052", strategy.short, alert_message="V71 PESQUISA REGIME SELL 20:52")
else if entraRegimeS2058
    strategy.entry("S2058", strategy.short, alert_message="V71 PESQUISA REGIME SELL 20:58")

strategy.exit("TP/SL B0348", from_entry="B0348", profit=takeTicks, loss=stopTicks)
strategy.exit("TP/SL S0348", from_entry="S0348", profit=takeTicks, loss=stopTicks)
strategy.exit("TP/SL B1030", from_entry="B1030", profit=takeTicks, loss=stopTicks)
strategy.exit("TP/SL S1030", from_entry="S1030", profit=takeTicks, loss=stopTicks)
strategy.exit("TP/SL B2052", from_entry="B2052", profit=takeTicks, loss=stopTicks)
strategy.exit("TP/SL S2052", from_entry="S2052", profit=takeTicks, loss=stopTicks)
strategy.exit("TP/SL B2058", from_entry="B2058", profit=takeTicks, loss=stopTicks)
strategy.exit("TP/SL S2058", from_entry="S2058", profit=takeTicks, loss=stopTicks)

plotshape(entraBaseB0348, title="BUY 03:48", style=shape.triangleup, location=location.belowbar, color=color.lime, size=size.normal, text="B0348")
plotshape(entraRegimeS0348, title="SELL 03:48", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.normal, text="S0348")
plotshape(entraBaseB1030 or entraRegimeB1030, title="BUY 10:30", style=shape.triangleup, location=location.belowbar, color=color.green, size=size.normal, text="B1030")
plotshape(entraBaseS1030 or entraRegimeS1030, title="SELL 10:30", style=shape.triangledown, location=location.abovebar, color=color.maroon, size=size.normal, text="S1030")
plotshape(entraRegimeB2052, title="BUY 20:52", style=shape.triangleup, location=location.belowbar, color=color.teal, size=size.normal, text="B2052")
plotshape(entraRegimeS2052, title="SELL 20:52", style=shape.triangledown, location=location.abovebar, color=color.fuchsia, size=size.normal, text="S2052")
plotshape(entraBaseB2058, title="BUY 20:58", style=shape.triangleup, location=location.belowbar, color=color.aqua, size=size.normal, text="B2058")
plotshape(entraRegimeS2058, title="SELL 20:58", style=shape.triangledown, location=location.abovebar, color=color.orange, size=size.normal, text="S2058")

compraCond = entraBaseB0348 or entraBaseB1030 or entraBaseB2058 or entraRegimeB1030 or entraRegimeB2052
vendaCond = entraBaseS1030 or entraRegimeS0348 or entraRegimeS1030 or entraRegimeS2052 or entraRegimeS2058
alertcondition(compraCond, title="V71 Pesquisa Regime BUY", message="V71 PESQUISA REGIME BUY")
alertcondition(vendaCond, title="V71 Pesquisa Regime SELL", message="V71 PESQUISA REGIME SELL")

var table painel = table.new(position.top_right, 2, 8, bgcolor=color.new(color.black, 20))
if mostrarPainel and barstate.islast
    table.cell(painel, 0, 0, "V71 PESQUISA", text_color=color.white)
    table.cell(painel, 1, 0, "REGIME 190/89", text_color=color.yellow)
    table.cell(painel, 0, 1, "Esperado local", text_color=color.white)
    table.cell(painel, 1, 1, "190 tr / 88.95% / PF 3.47", text_color=color.lime)
    table.cell(painel, 0, 2, "Hora SP", text_color=color.white)
    table.cell(painel, 1, 2, str.tostring(hSP) + ":" + (mSP < 10 ? "0" : "") + str.tostring(mSP), text_color=color.white)
    table.cell(painel, 0, 3, "ADX / Gap", text_color=color.white)
    table.cell(painel, 1, 3, str.tostring(adx14, "#.##") + " / " + str.tostring(dmiGap, "#.##"), text_color=color.white)
    table.cell(painel, 0, 4, "EMA34/200 slope", text_color=color.white)
    table.cell(painel, 1, 4, str.tostring(ema34Slope10, "#.##") + " / " + str.tostring(ema200Slope10, "#.##"), text_color=color.white)
    table.cell(painel, 0, 5, "Range30 / Ret60", text_color=color.white)
    table.cell(painel, 1, 5, str.tostring(range30, "#.##") + " / " + str.tostring(ret60, "#.##"), text_color=color.white)
    table.cell(painel, 0, 6, "TP/SL", text_color=color.white)
    table.cell(painel, 1, 6, str.tostring(takePontos) + " / " + str.tostring(stopPontos), text_color=color.white)
    table.cell(painel, 0, 7, "Oficial", text_color=color.white)
    table.cell(painel, 1, 7, "NAO ALTERADO", text_color=color.orange)
