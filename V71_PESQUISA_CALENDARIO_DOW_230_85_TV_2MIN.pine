//@version=6
strategy("V71 Pesquisa Calendario DOW 230-85 TV 2m",
     overlay=true,
     pyramiding=0,
     default_qty_type=strategy.fixed,
     default_qty_value=1)

// Pesquisa separada. Nao altera o V7.1 oficial.
// Perfil 01 local: 233 trades 365d, 87.55%, +6909 pts, DD -316.5, PF 3.04.
// Perfil 02 local: 234 trades 365d, 85.90%, +6289.5 pts, DD -316.5, PF 2.63; 30d 90.48%.
// Perfil 03 local: 230 trades 365d, 86.09%, +6255 pts, DD -300.5, PF 2.67; melhor pior-ano.
// Perfil 04 local: 222 trades 365d, 85.59%, +5851 pts, DD -351.0, PF 2.56; todos anos 80%+.
// Perfil 05 local: 147 trades 365d, 89.80%, +4911 pts, DD -183.5, PF 3.80; alta acertividade robusta.
// Validar no TradingView em MNQ1!, grafico de 2 minutos, com Backtesting Profundo.

takePontos = input.float(50.5, "Take em pontos", step=0.25)
stopPontos = input.float(117.0, "Stop em pontos", step=0.25)
perfil = input.string("05 Alta acerto 147tr 89pct", "Perfil",
     options=["01 Max 365d 233tr 87pct", "02 Recente forte 234tr 85pct", "03 Pior ano melhor 230tr 86pct", "04 Robusto anual 222tr 85pct", "05 Alta acerto 147tr 89pct"])

takeTicks = int(math.round(takePontos / syminfo.mintick))
stopTicks = int(math.round(stopPontos / syminfo.mintick))

ema17 = ta.ema(close, 17)
ema34 = ta.ema(close, 34)
ema200 = ta.ema(close, 200)
emaGap = math.abs(ema17 - ema34)
ema200Slope10 = ema200 - ema200[10]
range30 = ta.highest(high, 15) - ta.lowest(low, 15)
[diPlus, diMinus, adx14] = ta.dmi(14, 14)
dmiGap = math.abs(diPlus - diMinus)

typ = hlc3
newDaySP = ta.change(dayofmonth(time, "America/Sao_Paulo")) != 0
var float cumPV = na
var float cumVol = na
if newDaySP or na(cumPV)
    cumPV := typ * volume
    cumVol := volume
else
    cumPV += typ * volume
    cumVol += volume
vwapSP = cumVol != 0 ? cumPV / cumVol : na
distVwap = close - vwapSP
vwapSlope10 = vwapSP - vwapSP[10]

plot(ema17, "EMA 17", color=color.purple, linewidth=2)
plot(ema34, "EMA 34", color=color.blue, linewidth=2)
plot(ema200, "EMA 200", color=color.new(color.gray, 35), linewidth=1)

hSP = hour(time, "America/Sao_Paulo")
mSP = minute(time, "America/Sao_Paulo")
dowSP = dayofweek(time, "America/Sao_Paulo")
semPosicao = strategy.position_size == 0
perfilMax365 = perfil == "01 Max 365d 233tr 87pct"
perfilRecente = perfil == "02 Recente forte 234tr 85pct"
perfilPiorAno = perfil == "03 Pior ano melhor 230tr 86pct"
perfilRobusto = perfil == "04 Robusto anual 222tr 85pct"
perfilAltaAcerto = perfil == "05 Alta acerto 147tr 89pct"

seg0402BuyBase = dowSP == dayofweek.monday and hSP == 4 and mSP == 2
ter0312SellBase = dowSP == dayofweek.tuesday and hSP == 3 and mSP == 12
qua0256BuyBase = dowSP == dayofweek.wednesday and hSP == 2 and mSP == 56
qui0430SellBase = dowSP == dayofweek.thursday and hSP == 4 and mSP == 30
sex0930Buy = dowSP == dayofweek.friday and hSP == 9 and mSP == 30

seg0402Buy = seg0402BuyBase and (not perfilRecente or vwapSlope10 <= 4.6748) and (not perfilRobusto or emaGap >= 2.6933)
ter0312Sell = ter0312SellBase and (not perfilRecente or distVwap <= 22.2546) and (not perfilPiorAno or dmiGap >= 2.7238) and (not perfilAltaAcerto or range30 <= 16.75)
qua0256Buy = qua0256BuyBase and (not perfilMax365 or dmiGap >= 3.5237) and (not perfilAltaAcerto or emaGap >= 3.3369)
qui0430Sell = qui0430SellBase and (not perfilMax365 or ema200Slope10 <= 4.7472) and (not perfilPiorAno or dmiGap <= 12.7108) and (not perfilRobusto or (dmiGap <= 22.1959 and vwapSlope10 <= 1.9005)) and (not perfilAltaAcerto or adx14 <= 20.3605)

buySignal = semPosicao and (seg0402Buy or qua0256Buy or sex0930Buy)
sellSignal = semPosicao and (ter0312Sell or qui0430Sell)

if buySignal
    strategy.entry("BUY", strategy.long, alert_message="V71 PESQUISA CAL DOW 230-85 BUY")

if sellSignal
    strategy.entry("SELL", strategy.short, alert_message="V71 PESQUISA CAL DOW 230-85 SELL")

strategy.exit("TP/SL BUY", from_entry="BUY", profit=takeTicks, loss=stopTicks)
strategy.exit("TP/SL SELL", from_entry="SELL", profit=takeTicks, loss=stopTicks)

plotshape(buySignal, title="BUY", style=shape.triangleup, location=location.belowbar,
     color=color.lime, size=size.normal, text="BUY")
plotshape(sellSignal, title="SELL", style=shape.triangledown, location=location.abovebar,
     color=color.red, size=size.normal, text="SELL")

alertcondition(buySignal, title="V71 Pesquisa Calendario BUY", message="V71 PESQUISA CAL DOW 230-85 BUY")
alertcondition(sellSignal, title="V71 Pesquisa Calendario SELL", message="V71 PESQUISA CAL DOW 230-85 SELL")

var table painel = table.new(position.top_right, 2, 9, bgcolor=color.new(color.black, 20))
if barstate.islast
    table.cell(painel, 0, 0, "V71 Pesquisa", text_color=color.white)
    table.cell(painel, 1, 0, "CAL DOW 230-85", text_color=color.yellow)
    table.cell(painel, 0, 1, "TF", text_color=color.white)
    table.cell(painel, 1, 1, timeframe.period, text_color=color.white)
    table.cell(painel, 0, 2, "Perfil", text_color=color.white)
    table.cell(painel, 1, 2, perfilMax365 ? "01 MAX365" : perfilRecente ? "02 RECENTE" : perfilPiorAno ? "03 ANO" : perfilRobusto ? "04 ROB" : "05 ACC", text_color=color.yellow)
    table.cell(painel, 0, 3, "Seg 04:02", text_color=color.white)
    table.cell(painel, 1, 3, perfilRecente ? "BUY VWAP" : perfilRobusto ? "BUY EMA" : "BUY", text_color=color.lime)
    table.cell(painel, 0, 4, "Ter 03:12", text_color=color.white)
    table.cell(painel, 1, 4, perfilRecente ? "SELL VWAP" : perfilPiorAno ? "SELL DMI" : perfilAltaAcerto ? "SELL R30" : "SELL", text_color=color.red)
    table.cell(painel, 0, 5, "Qua 02:56", text_color=color.white)
    table.cell(painel, 1, 5, perfilMax365 ? "BUY DMI" : perfilAltaAcerto ? "BUY EMA" : "BUY", text_color=color.lime)
    table.cell(painel, 0, 6, "Qui 04:30", text_color=color.white)
    table.cell(painel, 1, 6, perfilMax365 ? "SELL EMA200" : perfilPiorAno ? "SELL DMI" : perfilRobusto ? "SELL ROB" : perfilAltaAcerto ? "SELL ADX" : "SELL", text_color=color.red)
    table.cell(painel, 0, 7, "Sex 09:30", text_color=color.white)
    table.cell(painel, 1, 7, "BUY", text_color=color.lime)
    table.cell(painel, 0, 8, "Oficial", text_color=color.white)
    table.cell(painel, 1, 8, "NAO ALTERADO", text_color=color.orange)
