//@version=6
strategy("V71 Teste TV Smoke Forca Entrada",
     overlay=true,
     pyramiding=0,
     default_qty_type=strategy.fixed,
     default_qty_value=1,
     process_orders_on_close=true)

// Teste minimo para confirmar que o TradingView esta executando estrategias.
// Se este arquivo nao gerar trades em MNQ1! 2m, o problema nao e a logica V71.

periodoBarras = input.int(50, "Entrar a cada N barras", minval=5, maxval=2000)
iniciarDepois = input.int(20, "Ignorar primeiras barras", minval=0, maxval=1000)

entra = bar_index > iniciarDepois and bar_index % periodoBarras == 0 and strategy.position_size == 0
fecha = strategy.position_size > 0 and bar_index % periodoBarras == 1

if entra
    strategy.entry("SMOKE_B", strategy.long)

if fecha
    strategy.close("SMOKE_B", comment="FECHA SMOKE")

plotshape(entra, title="SMOKE BUY", style=shape.square, location=location.belowbar,
     color=color.yellow, size=size.small, text="SMOKE")
plotshape(fecha, title="SMOKE CLOSE", style=shape.xcross, location=location.abovebar,
     color=color.orange, size=size.tiny, text="X")

var table painel = table.new(position.top_right, 2, 4, bgcolor=color.new(color.black, 20))
if barstate.islast
    table.cell(painel, 0, 0, "Smoke", text_color=color.white)
    table.cell(painel, 1, 0, "FORCA", text_color=color.yellow)
    table.cell(painel, 0, 1, "Bar index", text_color=color.white)
    table.cell(painel, 1, 1, str.tostring(bar_index), text_color=color.white)
    table.cell(painel, 0, 2, "Periodo", text_color=color.white)
    table.cell(painel, 1, 2, str.tostring(periodoBarras), text_color=color.white)
    table.cell(painel, 0, 3, "Posicao", text_color=color.white)
    table.cell(painel, 1, 3, str.tostring(strategy.position_size), text_color=color.white)
