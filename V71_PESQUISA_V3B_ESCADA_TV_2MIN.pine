//@version=6
strategy("V71 Pesquisa V3B Escada TV 2m",
     overlay=true,
     pyramiding=0,
     default_qty_type=strategy.fixed,
     default_qty_value=1)

// Pesquisa separada. NAO altera o V7.1 oficial.
// Usar no MNQ1! em 2 minutos.
// Este arquivo tem nome novo para evitar cache/input antigo do TradingView.
// Comece no perfil 01 e aperte aos poucos ate chegar no perfil 05.

perfil = input.string("04 Forte", "Perfil",
     options=["01 Entrada Forcada", "02 Solto DMI", "03 Moderado", "04 Forte", "05 Refino Aproximado"])
takePontos = input.float(50.5, "Take em pontos", step=0.25)
stopPontos = input.float(117.0, "Stop em pontos", step=0.25)
horaAlvo = input.int(20, "Hora alvo SP", minval=0, maxval=23)
minutoAlvo = input.int(58, "Minuto alvo SP", minval=0, maxval=59)
mostrarPainel = input.bool(true, "Mostrar painel")

takeTicks = int(math.round(takePontos / syminfo.mintick))
stopTicks = int(math.round(stopPontos / syminfo.mintick))

hSP = hour(time, "America/Sao_Paulo")
mSP = minute(time, "America/Sao_Paulo")
minSP = hSP * 60 + mSP
dowSP = dayofweek(time, "America/Sao_Paulo")
alvoSP = horaAlvo * 60 + minutoAlvo
dayKey = year(time, "America/Sao_Paulo") * 10000 + month(time, "America/Sao_Paulo") * 100 + dayofmonth(time, "America/Sao_Paulo")

var int dayKeyPrev = na
var bool entrouHoje = false
if na(dayKeyPrev) or dayKey != dayKeyPrev
    dayKeyPrev := dayKey
    entrouHoje := false

ema17 = ta.ema(close, 17)
ema34 = ta.ema(close, 34)
ema200 = ta.ema(close, 200)
sma17 = ta.sma(close, 17)
sma34 = ta.sma(close, 34)
ema12 = ta.ema(close, 12)
ema26 = ta.ema(close, 26)
macd = ema12 - ema26
macdSignal = ta.ema(macd, 9)
roc5 = close - close[5]
roc10 = close - close[10]
body = close - open
vwapDia = ta.vwap(hlc3)
rsi14 = ta.rsi(close, 14)
[diPlus, diMinus, adx14] = ta.dmi(14, 14)
dmiGap = math.abs(diPlus - diMinus)
range30 = ta.highest(high, 15) - ta.lowest(low, 15)

plot(ema17, "EMA 17", color=color.purple, linewidth=2)
plot(ema34, "EMA 34", color=color.blue, linewidth=2)

votoMacd = macd >= macdSignal ? 1 : -1
votoCandle = body >= 0 ? 1 : -1
votoSma1734 = sma17 >= sma34 ? 1 : -1
votoRoc5 = roc5 >= 0 ? 1 : -1
votoRoc10 = roc10 >= 0 ? 1 : -1
votoVwap = close >= vwapDia ? 1 : -1
votoDmi = diPlus >= diMinus ? 1 : -1
votoEma200 = close >= ema200 ? 1 : -1
votoRsi = rsi14 >= 50 ? 1 : -1
votoTotal = votoMacd + votoCandle + votoSma1734 + votoRoc5 + votoRoc10 + votoVwap + votoDmi + votoEma200 + votoRsi
votoSeguro = nz(votoTotal, ema17 >= ema34 ? 1 : -1)

perfilForcado = perfil == "01 Entrada Forcada"
perfilSolto = perfil == "02 Solto DMI"
perfilModerado = perfil == "03 Moderado"
perfilForte = perfil == "04 Forte"
perfilRefino = perfil == "05 Refino Aproximado"

horarioLiberado = minSP >= alvoSP
flat = strategy.position_size == 0
baseDisponivel = flat and not entrouHoje and horarioLiberado

direcaoBuyForcada = ema17 >= ema34
dowRefinoOk = dowSP == dayofweek.monday or dowSP == dayofweek.sunday or dowSP == dayofweek.thursday or dowSP == dayofweek.tuesday or dowSP == dayofweek.wednesday
vwapBuyOk = close >= vwapDia
vwapSellOk = close <= vwapDia

filtroForcado = perfilForcado
filtroSolto = perfilSolto and dmiGap >= 3
filtroModerado = perfilModerado and dmiGap >= 3 and math.abs(votoSeguro) >= 2 and range30 <= 180
filtroForte = perfilForte and dmiGap >= 3 and adx14 >= 15 and math.abs(votoSeguro) >= 2 and range30 <= 140 and ((votoSeguro >= 0 and vwapBuyOk) or (votoSeguro < 0 and vwapSellOk))
filtroRefino = perfilRefino and dowRefinoOk and adx14 >= 20 and math.abs(votoSeguro) >= 2 and range30 <= 120
filtroOk = filtroForcado or filtroSolto or filtroModerado or filtroForte or filtroRefino

direcaoBuy = perfilForcado ? direcaoBuyForcada : votoSeguro >= 0
entradaBuy = baseDisponivel and filtroOk and direcaoBuy
entradaSell = baseDisponivel and filtroOk and not direcaoBuy

if entradaBuy
    entrouHoje := true
    strategy.entry("B_ESCADA", strategy.long, alert_message="V71 PESQUISA V3B ESCADA BUY")
else if entradaSell
    entrouHoje := true
    strategy.entry("S_ESCADA", strategy.short, alert_message="V71 PESQUISA V3B ESCADA SELL")

strategy.exit("XB_ESCADA", from_entry="B_ESCADA", profit=takeTicks, loss=stopTicks)
strategy.exit("XS_ESCADA", from_entry="S_ESCADA", profit=takeTicks, loss=stopTicks)

plotshape(entradaBuy, title="BUY", style=shape.triangleup, location=location.belowbar,
     color=color.lime, size=size.small, text="BUY")
plotshape(entradaSell, title="SELL", style=shape.triangledown, location=location.abovebar,
     color=color.red, size=size.small, text="SELL")

alertcondition(entradaBuy, title="V71 Escada BUY", message="V71 PESQUISA V3B ESCADA BUY")
alertcondition(entradaSell, title="V71 Escada SELL", message="V71 PESQUISA V3B ESCADA SELL")

var table painel = table.new(position.top_right, 2, 9, bgcolor=color.new(color.black, 20))
if mostrarPainel and barstate.islast
    table.cell(painel, 0, 0, "V71 Escada", text_color=color.white)
    table.cell(painel, 1, 0, "2MIN", text_color=color.yellow)
    table.cell(painel, 0, 1, "Perfil", text_color=color.white)
    table.cell(painel, 1, 1, perfil, text_color=color.aqua)
    table.cell(painel, 0, 2, "Hora SP", text_color=color.white)
    table.cell(painel, 1, 2, str.tostring(hSP) + ":" + (mSP < 10 ? "0" : "") + str.tostring(mSP), text_color=color.white)
    table.cell(painel, 0, 3, "Liberado", text_color=color.white)
    table.cell(painel, 1, 3, horarioLiberado ? "SIM" : "NAO", text_color=horarioLiberado ? color.lime : color.gray)
    table.cell(painel, 0, 4, "Entrou hoje", text_color=color.white)
    table.cell(painel, 1, 4, entrouHoje ? "SIM" : "NAO", text_color=entrouHoje ? color.lime : color.gray)
    table.cell(painel, 0, 5, "DMI / ADX", text_color=color.white)
    table.cell(painel, 1, 5, str.tostring(dmiGap, "#.##") + " / " + str.tostring(adx14, "#.##"), text_color=color.white)
    table.cell(painel, 0, 6, "Voto / Range", text_color=color.white)
    table.cell(painel, 1, 6, str.tostring(votoSeguro) + " / " + str.tostring(range30, "#.##"), text_color=votoSeguro >= 0 ? color.lime : color.red)
    table.cell(painel, 0, 7, "TP/SL", text_color=color.white)
    table.cell(painel, 1, 7, str.tostring(takePontos) + " / " + str.tostring(stopPontos), text_color=color.white)
    table.cell(painel, 0, 8, "Oficial", text_color=color.white)
    table.cell(painel, 1, 8, "NAO ALTERADO", text_color=color.orange)
