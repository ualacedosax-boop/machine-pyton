//@version=6
strategy("V71 Pesquisa V3B Refino 223 Fixo TV 2m",
     overlay=true,
     pyramiding=0,
     default_qty_type=strategy.fixed,
     default_qty_value=1)

// Pesquisa separada. NAO altera o V7.1 oficial.
// Refino 223 fixo: base V2 robusta + fallback 20:58 somente em dia sem trade base.

r_takePontos = input.float(50.5, "Take em pontos", step=0.25)
r_stopPontos = input.float(117.0, "Stop em pontos", step=0.25)
r_mostrarPainel = input.bool(true, "Mostrar painel")

r_takeTicks = int(math.round(r_takePontos / syminfo.mintick))
r_stopTicks = int(math.round(r_stopPontos / syminfo.mintick))

r_hSP = hour(time, "America/Sao_Paulo")
r_mSP = minute(time, "America/Sao_Paulo")
r_minSP = r_hSP * 60 + r_mSP
r_dowSP = dayofweek(time, "America/Sao_Paulo")
r_dayKey = year(time, "America/Sao_Paulo") * 10000 + month(time, "America/Sao_Paulo") * 100 + dayofmonth(time, "America/Sao_Paulo")

var int r_dayKeyPrev = na
var bool r_baseHoje = false
var bool r_fallbackHoje = false
if na(r_dayKeyPrev) or r_dayKey != r_dayKeyPrev
    r_dayKeyPrev := r_dayKey
    r_baseHoje := false
    r_fallbackHoje := false

r_emJanela(minutoAtual, alvoMinutoDia, toleranciaMin) =>
    math.abs(minutoAtual - alvoMinutoDia) <= toleranciaMin

r_eh0346 = r_emJanela(r_minSP, 3 * 60 + 46, 1)
r_eh0348 = r_emJanela(r_minSP, 3 * 60 + 48, 1)
r_eh1030 = r_emJanela(r_minSP, 10 * 60 + 30, 1)
r_eh2052 = r_emJanela(r_minSP, 20 * 60 + 52, 1)
r_eh2058 = r_emJanela(r_minSP, 20 * 60 + 58, 1)

r_ema17 = ta.ema(close, 17)
r_ema34 = ta.ema(close, 34)
r_ema200 = ta.ema(close, 200)
r_sma17 = ta.sma(close, 17)
r_sma34 = ta.sma(close, 34)
r_ema12 = ta.ema(close, 12)
r_ema26 = ta.ema(close, 26)
r_macd = r_ema12 - r_ema26
r_macdSignal = ta.ema(r_macd, 9)
r_roc5 = close - close[5]
r_roc10 = close - close[10]
r_prevRoc5Contra = r_roc5[1] <= 0 ? 1 : -1
r_body = close - open
r_vwap = ta.vwap(hlc3)
r_rsi14 = ta.rsi(close, 14)
[r_diPlus, r_diMinus, r_adx14] = ta.dmi(14, 14)
r_dmiGap = math.abs(r_diPlus - r_diMinus)

r_range30 = ta.highest(high, 15) - ta.lowest(low, 15)
r_ret60 = close - close[30]
r_distVwap = close - r_vwap

plot(r_ema17, "EMA 17", color=color.purple, linewidth=2)
plot(r_ema34, "EMA 34", color=color.blue, linewidth=2)

r_votoMacd = r_macd >= r_macdSignal ? 1 : -1
r_votoCandle = r_body >= 0 ? 1 : -1
r_votoSma1734 = r_sma17 >= r_sma34 ? 1 : -1
r_votoRoc10 = r_roc10 >= 0 ? 1 : -1
r_votoEma1734 = r_ema17 >= r_ema34 ? 1 : -1
r_votoRoc5 = r_roc5 >= 0 ? 1 : -1
r_votoVwap = close >= r_vwap ? 1 : -1
r_votoDmi = r_diPlus >= r_diMinus ? 1 : -1
r_votoEma200 = close >= r_ema200 ? 1 : -1
r_votoRsi = r_rsi14 >= 50 ? 1 : -1
r_votoTotal = r_votoEma1734 + r_votoSma1734 + r_votoMacd + r_votoRoc5 + r_votoRoc10 + r_votoVwap + r_votoDmi + r_votoCandle + r_votoEma200 + r_votoRsi
r_votoTotalSeguro = nz(r_votoTotal, 1)

r_score0348 = r_votoMacd + r_votoCandle + r_prevRoc5Contra
r_score1030 = r_votoSma1734 + r_votoRoc10 + r_prevRoc5Contra
r_score2058 = r_votoEma1734 + r_votoRoc5 + r_votoVwap

r_dmi3Ok = r_dmiGap >= 3
r_dmi3Buy0348 = r_dmi3Ok and r_eh0348 and r_score0348 >= 0 and (r_dowSP == dayofweek.monday or r_dowSP == dayofweek.tuesday)
r_dmi3Buy1030 = r_dmi3Ok and r_eh1030 and r_score1030 >= 0 and r_dowSP == dayofweek.monday
r_dmi3Sell1030 = r_dmi3Ok and r_eh1030 and r_score1030 < 0 and r_dowSP == dayofweek.friday
r_dmi3Buy2058 = r_dmi3Ok and r_eh2058 and r_score2058 >= 0 and (r_dowSP == dayofweek.sunday or r_dowSP == dayofweek.wednesday)
r_baseAgora = r_dmi3Buy0348 or r_dmi3Buy1030 or r_dmi3Sell1030 or r_dmi3Buy2058

r_tendBuy = r_ema17 >= r_ema34 and r_diPlus >= r_diMinus
r_tendSell = r_ema17 < r_ema34 and r_diMinus > r_diPlus

// Modulos de regime mantidos no V2 robusto. REG_1030_BUY e REG_2052_SELL_B foram removidos.
r_reg0346Sell = not r_baseAgora and r_eh0346 and r_tendSell and r_dmiGap >= 6 and r_distVwap >= -7.26
r_reg0348Buy = not r_baseAgora and r_eh0348 and r_tendBuy and r_adx14 >= 25 and r_dmiGap >= 3 and r_ret60 <= 17.25
r_reg1030Sell = not r_baseAgora and r_eh1030 and r_tendSell and r_adx14 >= 25 and r_range30 <= 62.5
r_reg2052Buy = not r_baseAgora and r_eh2052 and r_tendBuy and r_adx14 >= 25 and r_range30 <= 18.44
r_reg2052SellA = not r_baseAgora and r_eh2052 and r_tendSell and r_adx14 >= 20 and r_dmiGap >= 10 and r_ret60 >= -27.75
r_reg2058Buy = not r_baseAgora and r_eh2058 and r_tendBuy and r_dmiGap >= 10 and r_dmiGap <= 13.35

r_baseBuyCond = r_dmi3Buy0348 or r_dmi3Buy1030 or r_dmi3Buy2058 or r_reg0348Buy or r_reg2052Buy or r_reg2058Buy
r_baseSellCond = r_dmi3Sell1030 or r_reg0346Sell or r_reg1030Sell or r_reg2052SellA

// Fallback Refino 223:
// - somente 20:58;
// - somente se nao houve trade base no dia;
// - sem sexta/sabado;
// - ADX >= 20, forca de voto >= 2, range 30m <= 120.
r_fbDowOk = r_dowSP == dayofweek.monday or r_dowSP == dayofweek.sunday or r_dowSP == dayofweek.thursday or r_dowSP == dayofweek.tuesday or r_dowSP == dayofweek.wednesday
r_fbBase = not r_baseHoje and not r_fallbackHoje and r_eh2058 and r_fbDowOk and r_adx14 >= 20 and math.abs(r_votoTotalSeguro) >= 2 and r_range30 <= 120
r_fbBuy = r_fbBase and r_votoTotalSeguro >= 0
r_fbSell = r_fbBase and r_votoTotalSeguro < 0

r_flat = strategy.position_size == 0

if r_flat and r_dmi3Buy0348
    r_baseHoje := true
    strategy.entry("D3B0348", strategy.long, alert_message="V71 V3B REFINO DMI3 BUY 03:48")
else if r_flat and r_dmi3Buy1030
    r_baseHoje := true
    strategy.entry("D3B1030", strategy.long, alert_message="V71 V3B REFINO DMI3 BUY 10:30")
else if r_flat and r_dmi3Buy2058
    r_baseHoje := true
    strategy.entry("D3B2058", strategy.long, alert_message="V71 V3B REFINO DMI3 BUY 20:58")
else if r_flat and r_dmi3Sell1030
    r_baseHoje := true
    strategy.entry("D3S1030", strategy.short, alert_message="V71 V3B REFINO DMI3 SELL 10:30")
else if r_flat and r_reg0346Sell
    r_baseHoje := true
    strategy.entry("R0346S", strategy.short, alert_message="V71 V3B REFINO SELL 03:46")
else if r_flat and r_reg0348Buy
    r_baseHoje := true
    strategy.entry("R0348B", strategy.long, alert_message="V71 V3B REFINO BUY 03:48")
else if r_flat and r_reg1030Sell
    r_baseHoje := true
    strategy.entry("R1030S", strategy.short, alert_message="V71 V3B REFINO SELL 10:30")
else if r_flat and r_reg2052Buy
    r_baseHoje := true
    strategy.entry("R2052B", strategy.long, alert_message="V71 V3B REFINO BUY 20:52")
else if r_flat and r_reg2052SellA
    r_baseHoje := true
    strategy.entry("R2052SA", strategy.short, alert_message="V71 V3B REFINO SELL 20:52 A")
else if r_flat and r_reg2058Buy
    r_baseHoje := true
    strategy.entry("R2058B", strategy.long, alert_message="V71 V3B REFINO BUY 20:58")
else if r_flat and r_fbBuy
    r_fallbackHoje := true
    strategy.entry("FBB223", strategy.long, alert_message="V71 V3B REFINO FALLBACK BUY 20:58")
else if r_flat and r_fbSell
    r_fallbackHoje := true
    strategy.entry("FBS223", strategy.short, alert_message="V71 V3B REFINO FALLBACK SELL 20:58")

strategy.exit("XD3B0348", from_entry="D3B0348", profit=r_takeTicks, loss=r_stopTicks)
strategy.exit("XD3B1030", from_entry="D3B1030", profit=r_takeTicks, loss=r_stopTicks)
strategy.exit("XD3B2058", from_entry="D3B2058", profit=r_takeTicks, loss=r_stopTicks)
strategy.exit("XD3S1030", from_entry="D3S1030", profit=r_takeTicks, loss=r_stopTicks)
strategy.exit("XR0346S", from_entry="R0346S", profit=r_takeTicks, loss=r_stopTicks)
strategy.exit("XR0348B", from_entry="R0348B", profit=r_takeTicks, loss=r_stopTicks)
strategy.exit("XR1030S", from_entry="R1030S", profit=r_takeTicks, loss=r_stopTicks)
strategy.exit("XR2052B", from_entry="R2052B", profit=r_takeTicks, loss=r_stopTicks)
strategy.exit("XR2052SA", from_entry="R2052SA", profit=r_takeTicks, loss=r_stopTicks)
strategy.exit("XR2058B", from_entry="R2058B", profit=r_takeTicks, loss=r_stopTicks)
strategy.exit("XFBB223", from_entry="FBB223", profit=r_takeTicks, loss=r_stopTicks)
strategy.exit("XFBS223", from_entry="FBS223", profit=r_takeTicks, loss=r_stopTicks)

r_buyEntry = r_flat and (r_baseBuyCond or r_fbBuy)
r_sellEntry = r_flat and (r_baseSellCond or r_fbSell)

plotshape(r_buyEntry, title="BUY", style=shape.triangleup, location=location.belowbar,
     color=color.lime, size=size.small, text="BUY")
plotshape(r_sellEntry, title="SELL", style=shape.triangledown, location=location.abovebar,
     color=color.red, size=size.small, text="SELL")

alertcondition(r_buyEntry, title="V71 V3B Refino BUY", message="V71 V3B REFINO BUY")
alertcondition(r_sellEntry, title="V71 V3B Refino SELL", message="V71 V3B REFINO SELL")

var table r_painel = table.new(position.top_right, 2, 9, bgcolor=color.new(color.black, 20))
if r_mostrarPainel and barstate.islast
    table.cell(r_painel, 0, 0, "V71 Pesquisa", text_color=color.white)
    table.cell(r_painel, 1, 0, "REFINO 223", text_color=color.yellow)
    table.cell(r_painel, 0, 1, "Base", text_color=color.white)
    table.cell(r_painel, 1, 1, "V2 robusto", text_color=color.lime)
    table.cell(r_painel, 0, 2, "Fallback", text_color=color.white)
    table.cell(r_painel, 1, 2, "20:58 fixo", text_color=color.white)
    table.cell(r_painel, 0, 3, "Filtro FB", text_color=color.white)
    table.cell(r_painel, 1, 3, "ADX20 voto2 range120", text_color=color.aqua)
    table.cell(r_painel, 0, 4, "Hora SP", text_color=color.white)
    table.cell(r_painel, 1, 4, str.tostring(r_hSP) + ":" + (r_mSP < 10 ? "0" : "") + str.tostring(r_mSP), text_color=color.white)
    table.cell(r_painel, 0, 5, "Base hoje", text_color=color.white)
    table.cell(r_painel, 1, 5, r_baseHoje ? "SIM" : "NAO", text_color=r_baseHoje ? color.lime : color.gray)
    table.cell(r_painel, 0, 6, "Fallback hoje", text_color=color.white)
    table.cell(r_painel, 1, 6, r_fallbackHoje ? "SIM" : "NAO", text_color=r_fallbackHoje ? color.lime : color.gray)
    table.cell(r_painel, 0, 7, "TP/SL", text_color=color.white)
    table.cell(r_painel, 1, 7, str.tostring(r_takePontos) + " / " + str.tostring(r_stopPontos), text_color=color.white)
    table.cell(r_painel, 0, 8, "Oficial", text_color=color.white)
    table.cell(r_painel, 1, 8, "NAO ALTERADO", text_color=color.orange)
