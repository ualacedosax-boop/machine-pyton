//@version=6
strategy("V71 Pesquisa 6MIN Compilado 0406 3H",
     overlay=true,
     pyramiding=0,
     default_qty_type=strategy.fixed,
     default_qty_value=1,
     process_orders_on_close=true)

// Pesquisa separada. NAO altera o V7.1 oficial.
// Usar no MNQ1! em 6 minutos.
// Combina a reversao 04:06 de 6m com os blocos 03:48 / 10:30 / 20:58 DMI3.

perfil = input.string("Compilado 6m", "Perfil",
     options=["Compilado 6m", "0406 Reversao", "3H DMI3", "Frequencia 6m"])
takePts = input.float(50.5, "Take em pontos", step=0.25)
stopPts = input.float(117.0, "Stop em pontos", step=0.25)
dmiGapMin = input.float(3.0, "DMI gap minimo", step=0.5)
adxFreqMin = input.float(20.0, "Frequencia: ADX minimo", step=0.5)
votoFreqMin = input.int(2, "Frequencia: forca voto", minval=0, maxval=10)
rangeRatioMax = input.float(1.5, "04:06 range ratio max", step=0.1)
extremoMin = input.float(0.80, "04:06 extremo min alta", step=0.05)
usarFiltro0406Alta = input.bool(false, "04:06 filtro alta acertividade")
mostrarPainel = input.bool(true, "Mostrar painel")

takeTicks = int(math.round(takePts / syminfo.mintick))
stopTicks = int(math.round(stopPts / syminfo.mintick))

hSP = hour(time, "America/Sao_Paulo")
mSP = minute(time, "America/Sao_Paulo")
minSP = hSP * 60 + mSP
dowSP = dayofweek(time, "America/Sao_Paulo")
dayKey = year(time, "America/Sao_Paulo") * 10000 + month(time, "America/Sao_Paulo") * 100 + dayofmonth(time, "America/Sao_Paulo")

var int dayKeyPrev = na
var bool fez0348 = false
var bool fez0406 = false
var bool fez1030 = false
var bool fez2058 = false
if na(dayKeyPrev) or dayKey != dayKeyPrev
    dayKeyPrev := dayKey
    fez0348 := false
    fez0406 := false
    fez1030 := false
    fez2058 := false

f_slot(done, alvo, limite) =>
    not done and minSP >= alvo and minSP <= limite

slot0348 = f_slot(fez0348, 3 * 60 + 48, 4 * 60 + 0)
slot0406 = f_slot(fez0406, 4 * 60 + 6, 4 * 60 + 18)
slot1030 = f_slot(fez1030, 10 * 60 + 30, 10 * 60 + 42)
slot2058 = f_slot(fez2058, 20 * 60 + 58, 21 * 60 + 12)

ema17 = ta.ema(close, 17)
ema34 = ta.ema(close, 34)
sma17 = ta.sma(close, 17)
sma34 = ta.sma(close, 34)
ema12 = ta.ema(close, 12)
ema26 = ta.ema(close, 26)
macd = ema12 - ema26
macdSignal = ta.ema(macd, 9)
roc5 = close - close[5]
roc10 = close - close[10]
prevRoc5 = roc5[1]
body = close - open
vwapDia = ta.vwap(hlc3)
rsi14 = ta.rsi(close, 14)
[diPlus, diMinus, adx14] = ta.dmi(14, 14)
dmiGap = math.abs(diPlus - diMinus)

plot(ema17, "EMA 17", color=color.purple, linewidth=2)
plot(ema34, "EMA 34", color=color.blue, linewidth=2)

votoMacd = macd >= macdSignal ? 1 : -1
votoCandle = body >= 0 ? 1 : -1
votoPrevRoc5Contra = prevRoc5 <= 0 ? 1 : -1
votoSma1734 = sma17 >= sma34 ? 1 : -1
votoRoc10 = roc10 >= 0 ? 1 : -1
votoEma1734 = ema17 >= ema34 ? 1 : -1
votoRoc5 = roc5 >= 0 ? 1 : -1
votoVwap = close >= vwapDia ? 1 : -1
votoDmi = diPlus >= diMinus ? 1 : -1
votoRsi = rsi14 >= 50 ? 1 : -1
votoTotal = votoMacd + votoCandle + votoSma1734 + votoRoc10 + votoEma1734 + votoRoc5 + votoVwap + votoDmi + votoRsi

score0348 = votoMacd + votoCandle + votoPrevRoc5Contra
score1030 = votoSma1734 + votoRoc10 + votoPrevRoc5Contra
score2058 = votoEma1734 + votoRoc5 + votoVwap
regimeOk = dmiGap >= dmiGapMin

rangeAtual = high - low
rangeMed10 = ta.sma(rangeAtual, 10)
rangeRatio10 = rangeAtual / math.max(rangeMed10, syminfo.mintick)
max20 = ta.highest(high, 20)
min20 = ta.lowest(low, 20)
posRange20 = (close - min20) / math.max(max20 - min20, syminfo.mintick)
revBuy = posRange20 <= 0.35
revSell = posRange20 >= 0.65
extremoRev = revBuy ? 1.0 - posRange20 : revSell ? posRange20 : na
candleBuy = close >= open
mesmoSentidoCandle = revBuy ? candleBuy : revSell ? not candleBuy : false
filtro0406Robusto = rangeRatio10 <= rangeRatioMax
filtro0406Alta = filtro0406Robusto and extremoRev >= extremoMin and not mesmoSentidoCandle
filtro0406 = usarFiltro0406Alta ? filtro0406Alta : filtro0406Robusto

usa0406 = perfil == "Compilado 6m" or perfil == "0406 Reversao"
usa3H = perfil == "Compilado 6m" or perfil == "3H DMI3"
usaFreq = perfil == "Frequencia 6m"

buy0406 = usa0406 and slot0406 and revBuy and filtro0406
sell0406 = usa0406 and slot0406 and revSell and filtro0406

buy0348Dmi = usa3H and regimeOk and slot0348 and score0348 >= 0 and (dowSP == dayofweek.monday or dowSP == dayofweek.tuesday)
buy1030Dmi = usa3H and regimeOk and slot1030 and score1030 >= 0 and dowSP == dayofweek.monday
sell1030Dmi = usa3H and regimeOk and slot1030 and score1030 < 0 and dowSP == dayofweek.friday
buy2058Dmi = usa3H and regimeOk and slot2058 and score2058 >= 0 and (dowSP == dayofweek.sunday or dowSP == dayofweek.wednesday)

freqBase = usaFreq and regimeOk and adx14 >= adxFreqMin and math.abs(votoTotal) >= votoFreqMin
buyFreq = freqBase and (slot0348 or slot1030 or slot2058) and votoTotal >= 0
sellFreq = freqBase and (slot0348 or slot1030 or slot2058) and votoTotal < 0

compra = strategy.position_size == 0 and (buy0406 or buy0348Dmi or buy1030Dmi or buy2058Dmi or buyFreq)
venda = strategy.position_size == 0 and (sell0406 or sell1030Dmi or sellFreq)

if slot0348
    fez0348 := true
if slot0406
    fez0406 := true
if slot1030
    fez1030 := true
if slot2058
    fez2058 := true

if compra and buy0406
    strategy.entry("B0406", strategy.long, alert_message="V71 PESQUISA 6M BUY 04:06")
else if venda and sell0406
    strategy.entry("S0406", strategy.short, alert_message="V71 PESQUISA 6M SELL 04:06")
else if compra and buy0348Dmi
    strategy.entry("B0348D", strategy.long, alert_message="V71 PESQUISA 6M DMI BUY 03:48")
else if compra and buy1030Dmi
    strategy.entry("B1030D", strategy.long, alert_message="V71 PESQUISA 6M DMI BUY 10:30")
else if venda and sell1030Dmi
    strategy.entry("S1030D", strategy.short, alert_message="V71 PESQUISA 6M DMI SELL 10:30")
else if compra and buy2058Dmi
    strategy.entry("B2058D", strategy.long, alert_message="V71 PESQUISA 6M DMI BUY 20:58")
else if compra and buyFreq
    strategy.entry("BFREQ", strategy.long, alert_message="V71 PESQUISA 6M FREQ BUY")
else if venda and sellFreq
    strategy.entry("SFREQ", strategy.short, alert_message="V71 PESQUISA 6M FREQ SELL")

strategy.exit("XB0406", from_entry="B0406", profit=takeTicks, loss=stopTicks)
strategy.exit("XS0406", from_entry="S0406", profit=takeTicks, loss=stopTicks)
strategy.exit("XB0348D", from_entry="B0348D", profit=takeTicks, loss=stopTicks)
strategy.exit("XB1030D", from_entry="B1030D", profit=takeTicks, loss=stopTicks)
strategy.exit("XS1030D", from_entry="S1030D", profit=takeTicks, loss=stopTicks)
strategy.exit("XB2058D", from_entry="B2058D", profit=takeTicks, loss=stopTicks)
strategy.exit("XBFREQ", from_entry="BFREQ", profit=takeTicks, loss=stopTicks)
strategy.exit("XSFREQ", from_entry="SFREQ", profit=takeTicks, loss=stopTicks)

plotshape(compra, title="BUY", style=shape.triangleup, location=location.belowbar,
     color=color.lime, size=size.small, text="BUY")
plotshape(venda, title="SELL", style=shape.triangledown, location=location.abovebar,
     color=color.red, size=size.small, text="SELL")

alertcondition(compra, title="V71 Pesquisa 6M BUY", message="V71 PESQUISA 6M BUY")
alertcondition(venda, title="V71 Pesquisa 6M SELL", message="V71 PESQUISA 6M SELL")

var table painel = table.new(position.top_right, 2, 9, bgcolor=color.new(color.black, 20))
if mostrarPainel and barstate.islast
    table.cell(painel, 0, 0, "V71 Pesquisa", text_color=color.white)
    table.cell(painel, 1, 0, "6MIN", text_color=color.yellow)
    table.cell(painel, 0, 1, "Perfil", text_color=color.white)
    table.cell(painel, 1, 1, perfil, text_color=color.aqua)
    table.cell(painel, 0, 2, "Hora SP", text_color=color.white)
    table.cell(painel, 1, 2, str.tostring(hSP) + ":" + (mSP < 10 ? "0" : "") + str.tostring(mSP), text_color=color.white)
    table.cell(painel, 0, 3, "Slots", text_color=color.white)
    table.cell(painel, 1, 3, "03:48 04:06 10:30 20:58", text_color=color.white)
    table.cell(painel, 0, 4, "DMI gap", text_color=color.white)
    table.cell(painel, 1, 4, str.tostring(dmiGap, "#.##"), text_color=regimeOk ? color.lime : color.gray)
    table.cell(painel, 0, 5, "Voto", text_color=color.white)
    table.cell(painel, 1, 5, str.tostring(votoTotal), text_color=votoTotal >= 0 ? color.lime : color.red)
    table.cell(painel, 0, 6, "04:06 pos/range", text_color=color.white)
    table.cell(painel, 1, 6, str.tostring(posRange20, "#.##") + " / " + str.tostring(rangeRatio10, "#.##"), text_color=filtro0406 ? color.lime : color.gray)
    table.cell(painel, 0, 7, "TP/SL", text_color=color.white)
    table.cell(painel, 1, 7, str.tostring(takePts) + " / " + str.tostring(stopPts), text_color=color.white)
    table.cell(painel, 0, 8, "Oficial", text_color=color.white)
    table.cell(painel, 1, 8, "NAO ALTERADO", text_color=color.orange)
