//@version=6
strategy("V71 Pesquisa 0406 Reversao Multiano TV 6m",
     overlay=true,
     pyramiding=0,
     default_qty_type=strategy.fixed,
     default_qty_value=1,
     initial_capital=50000,
     currency=currency.USD,
     commission_type=strategy.commission.cash_per_contract,
     commission_value=0.85,
     process_orders_on_close=true)

// Pesquisa separada. NAO altera o V7.1 oficial.
// Use no MNQ1! em 6 minutos com Backtesting Profundo.
// Perfil base local:
// 01 Sem filtro: 373 trades, 80.16%, +6441.5 pontos, DD -550.5, PF 1.74.
// 02 Multiano 86: 122 trades, 86.07%, +3313.5 pontos, DD -183.5, PF 2.67.
// 03 Simples 85: 120 trades, 85.83%, +3212.5 pontos, DD -300.5, PF 2.62.

perfil = input.string("02 Multiano 86pct", "Perfil",
     options=["01 Sem filtro 80pct", "02 Multiano 86pct", "03 Simples 85pct"])
takePontos = input.float(50.5, "Take em pontos", step=0.25)
stopPontos = input.float(117.0, "Stop em pontos", step=0.25)
mostrarPainel = input.bool(true, "Mostrar painel")
mostrarSinais = input.bool(true, "Mostrar sinais")
destacar0406 = input.bool(true, "Destacar candle 04:06")

takeTicks = int(math.round(takePontos / syminfo.mintick))
stopTicks = int(math.round(stopPontos / syminfo.mintick))

hSP = hour(time, "America/Sao_Paulo")
mSP = minute(time, "America/Sao_Paulo")
eh0406 = hSP == 4 and mSP == 6

diaSP = year(time, "America/Sao_Paulo") * 10000 + month(time, "America/Sao_Paulo") * 100 + dayofmonth(time, "America/Sao_Paulo")
var int diaControle = na
var bool entrouHoje = false
if na(diaControle) or diaSP != diaControle
    diaControle := diaSP
    entrouHoje := false

rangeAtual = high - low
rangeMed10 = ta.sma(rangeAtual, 10)
rangeRatio10 = rangeAtual / math.max(rangeMed10, syminfo.mintick)
rsi14 = ta.rsi(close, 14)

max20 = ta.highest(high, 20)
min20 = ta.lowest(low, 20)
posRange20 = (close - min20) / math.max(max20 - min20, syminfo.mintick)

direcaoBuy = posRange20 <= 0.35
direcaoSell = posRange20 >= 0.65
temReversao = direcaoBuy or direcaoSell
extremoReversao = direcaoBuy ? 1.0 - posRange20 : direcaoSell ? posRange20 : na

candleBuy = close >= open
mesmoSentidoCandle = direcaoBuy ? candleBuy : direcaoSell ? not candleBuy : false

p1 = perfil == "01 Sem filtro 80pct"
p2 = perfil == "02 Multiano 86pct"
p3 = perfil == "03 Simples 85pct"

filtroSem = true
filtroMultiano = rangeRatio10 <= 1.5 and extremoReversao >= 0.8 and not mesmoSentidoCandle
filtroSimples = rsi14 <= 40 and rangeRatio10 >= 0.7
filtroFinal = p1 ? filtroSem : p2 ? filtroMultiano : filtroSimples

podeEntrar = eh0406 and not entrouHoje and strategy.position_size == 0 and temReversao and filtroFinal
compra = podeEntrar and direcaoBuy
venda = podeEntrar and direcaoSell

if compra
    strategy.entry("B0406", strategy.long, alert_message="V71 PESQUISA 0406 BUY")
    strategy.exit("TP/SL B0406", from_entry="B0406", profit=takeTicks, loss=stopTicks)
    entrouHoje := true
else if venda
    strategy.entry("S0406", strategy.short, alert_message="V71 PESQUISA 0406 SELL")
    strategy.exit("TP/SL S0406", from_entry="S0406", profit=takeTicks, loss=stopTicks)
    entrouHoje := true

alertcondition(compra, title="V71 Pesquisa 0406 BUY", message="V71 PESQUISA 0406 BUY")
alertcondition(venda, title="V71 Pesquisa 0406 SELL", message="V71 PESQUISA 0406 SELL")

bgcolor(destacar0406 and eh0406 ? color.new(color.yellow, 84) : na, title="Candle 04:06")
plotshape(mostrarSinais and compra, title="BUY 04:06", style=shape.triangleup, location=location.belowbar,
     color=color.lime, size=size.large, text="B0406")
plotshape(mostrarSinais and venda, title="SELL 04:06", style=shape.triangledown, location=location.abovebar,
     color=color.red, size=size.large, text="S0406")

plot(posRange20, "pos_range_20", color=color.new(color.aqua, 0), display=display.data_window)
plot(rangeRatio10, "range_ratio_10", color=color.new(color.orange, 0), display=display.data_window)
plot(extremoReversao, "extremo_reversao", color=color.new(color.fuchsia, 0), display=display.data_window)
plot(rsi14, "rsi_14", color=color.new(color.yellow, 0), display=display.data_window)

esperado = p1 ? "373 tr / 80.16% / PF 1.74" : p2 ? "122 tr / 86.07% / PF 2.67" : "120 tr / 85.83% / PF 2.62"
anos = p1 ? "2024/25/26: 80.5/79.8/80.6" : p2 ? "2024/25/26: 86.1/84.6/90.5" : "2024/25/26: 90.2/79.3/95.2"
filtroTxt = p1 ? "sem filtro" : p2 ? "range<=1.5 extremo>=0.8 candle contra" : "RSI<=40 range>=0.7"

var table painel = table.new(position.top_right, 2, 9, bgcolor=color.new(color.black, 22))
if mostrarPainel and barstate.islast
    table.cell(painel, 0, 0, "V71 PESQUISA", text_color=color.white)
    table.cell(painel, 1, 0, "04:06 6M", text_color=color.yellow)
    table.cell(painel, 0, 1, "Perfil", text_color=color.white)
    table.cell(painel, 1, 1, perfil, text_color=color.aqua)
    table.cell(painel, 0, 2, "Esperado local", text_color=color.white)
    table.cell(painel, 1, 2, esperado, text_color=color.lime)
    table.cell(painel, 0, 3, "Anos", text_color=color.white)
    table.cell(painel, 1, 3, anos, text_color=color.white)
    table.cell(painel, 0, 4, "Filtro", text_color=color.white)
    table.cell(painel, 1, 4, filtroTxt, text_color=color.white)
    table.cell(painel, 0, 5, "Direcao", text_color=color.white)
    table.cell(painel, 1, 5, direcaoBuy ? "BUY" : direcaoSell ? "SELL" : "NONE", text_color=direcaoBuy ? color.lime : direcaoSell ? color.red : color.gray)
    table.cell(painel, 0, 6, "Range/Ext/RSI", text_color=color.white)
    table.cell(painel, 1, 6, str.tostring(rangeRatio10, "#.##") + " / " + str.tostring(extremoReversao, "#.##") + " / " + str.tostring(rsi14, "#.##"), text_color=color.white)
    table.cell(painel, 0, 7, "Entrou hoje", text_color=color.white)
    table.cell(painel, 1, 7, entrouHoje ? "SIM" : "NAO", text_color=entrouHoje ? color.orange : color.lime)
    table.cell(painel, 0, 8, "Oficial", text_color=color.white)
    table.cell(painel, 1, 8, "NAO ALTERADO", text_color=color.orange)
